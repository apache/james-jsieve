options {
  MULTI=true;
  VISITOR=true;
  VISITOR_EXCEPTION="org.apache.jsieve.exception.SieveException";
  NODE_PACKAGE="org.apache.jsieve.parser.generated";
  NODE_DEFAULT_VOID=false;
  STATIC = false;
  // Sieve has no Java style unicode escape (RFC 5228 section 2.4.2): read the characters as they are
  JAVA_UNICODE_ESCAPE = false;
  UNICODE_INPUT = true;
  DEBUG_PARSER = false;
  OUTPUT_DIRECTORY="./org/apache/jsieve/parser/generated";
  NODE_EXTENDS="org.apache.jsieve.parser.SieveNode";
  NODE_SCOPE_HOOK=true;
  JDK_VERSION="1.5";
}

PARSER_BEGIN(SieveParser)

package org.apache.jsieve.parser.generated;

import org.apache.jsieve.*;
import org.apache.jsieve.parser.*;

public class SieveParser {

  /**
   * The deepest nesting accepted, blocks and tests counted together: well
   * above the fifteen levels of nested blocks and of nested test lists that
   * RFC 5228 section 2.10.7 requires. Parsing, validating and evaluating a
   * script recurse once per level: an unbounded nesting would overflow the
   * stack.
   */
  public static final int MAX_NESTING = 100;

  /**
   * The value of a multi-line literal (RFC 5228 section 2.4.2): its lines
   * after "text:" and the comment or CRLF ending it, without the terminating
   * "." CRLF nor the line break of the last line, dot-stuffing removed. Lines
   * may end with CRLF, LF or CR.
   */
  static String multiLineValue(String image) {
    int start = "text:".length();
    while (image.charAt(start) == ' ' || image.charAt(start) == '\t') {
      start++;
    }
    if (image.charAt(start) == '#') {
      while (image.charAt(start) != '\r' && image.charAt(start) != '\n') {
        start++;
      }
    }
    start += image.startsWith("\r\n", start) ? 2 : 1;
    // without the terminating "." CRLF
    int end = image.length() - 3;
    if (end - start >= 2 && image.startsWith("\r\n", end - 2)) {
      end -= 2;
    } else if (end > start) {
      end--;
    }
    final StringBuilder value = new StringBuilder(end - start);
    boolean lineStart = true;
    for (int i = start; i < end; i++) {
      final char c = image.charAt(i);
      if (!lineStart || c != '.' || i + 1 >= end || image.charAt(i + 1) != '.') {
        value.append(c);
      }
      lineStart = c == '\n' || (c == '\r' && (i + 1 >= end || image.charAt(i + 1) != '\n'));
    }
    return value.toString();
  }

  /**
   * Removes each backslash, keeping the character it precedes.
   */
  static String unescape(String string) {
    final StringBuilder value = new StringBuilder(string.length());
    for (int i = 0; i < string.length(); i++) {
      final char c = string.charAt(i);
      if (c != '\\') {
        value.append(c);
      } else if (++i < string.length()) {
        value.append(string.charAt(i));
      }
    }
    return value.toString();
  }

  /** The blocks and tests enclosing the current token. */
  private int nesting;

  /**
   * Enters a block or a test, the token just read opening it.
   */
  private void enterNesting() throws ParseException {
    if (++nesting > MAX_NESTING) {
      throw new ParseException("Blocks and tests nested deeper than " + MAX_NESTING + " levels, counted together, at line "
          + token.beginLine + ", column " + token.beginColumn + ".");
    }
  }

  public void jjtreeOpenNodeScope(Node n) {
    ((SieveNode) n).setFirstToken(getToken(1));
  }
  
  public void jjtreeCloseNodeScope(Node n) {
    ((SieveNode) n).setLastToken(getToken(0));
  }
}

PARSER_END(SieveParser)

/*****************************************
 * THE SIEVE LANGUAGE TOKENS STARTS HERE *
 *****************************************/

SKIP : /* WHITE SPACE */
{
  " "
| "\t"
| "\n"
| "\r"
| "\f"
}

SPECIAL_TOKEN : /* COMMENTS */
{
  <HASH_COMMENT: "#" (~["\n","\r"])* ("\n"|"\r"|"\r\n")>
| 
  <BRACKET_COMMENT: "/*" (~["*"])* "*" ("*" | (~["*","/"] (~["*"])* "*"))* "/">
}

TOKEN : /* Can't make this one special */
{
  <EOF_HASH_COMMENT: "#" (~["\n","\r"])*>
}              


// identifier = (ALPHA / "_") *(ALPHA DIGIT "_")
TOKEN : /* IDENTIFIER */
{
   <IDENTIFIER: (<ALPHA>|"_") (<ALPHA>|<DIGIT>|"_")*>
|
  < #ALPHA:
      [
       "\u0041"-"\u005a",
       "\u0061"-"\u007a"
      ]
  >
|
  < #DIGIT:
      [
       "\u0030"-"\u0039"
      ]
  >  
}

// tag = ":" identifier
TOKEN : /* TAG */
{
   <TAG: ":" <IDENTIFIER> >
}

TOKEN : /* LITERALS */
{
// number = 1*DIGIT [QUANTIFIER]
// QUANTIFIER = "K" / "M" / "G", case-insensitive like every number (RFC 5228 section 8.1)
   < NUMBER: 
       <DECIMAL_LITERAL> (<QUANTIFIER>)?
   >
|
  < #DECIMAL_LITERAL: (["0"-"9"])+ >
|
  < #QUANTIFIER: ["K","M","G","k","m","g"] >    
|
// quoted-string = DQUOTE *CHAR DQUOTE
// in general, \ CHAR inside a string maps to CHAR
// so \" maps to " and \\ maps to \
// note that newlines and other characters are all allowed strings
  < QUOTED_STRING:
      "\""
      (~["\"","\\"]|<ESCAPED_CHAR>)*
      "\""
  >
|
// an undefined escape, such as \a, means the character itself (RFC 5228 section 2.4.2); NUL is no Sieve character
  <#ESCAPED_CHAR:
      ("\\" ~["\u0000"])
  >
|
// multi-line = "text:" *(SP / HTAB) (hash-comment / CRLF)
//               *(multi-line-literal / multi-line-dotstuff)
//               "." CRLF
// Hmm. What we need to do is treat (CRLF / LF / CR) as <NEWLINE> throughout
  < MULTI_LINE:
      <MULTI_LINE_START>
      (<MULTI_LINE_LITERAL> |<MULTI_LINE_DOTSTUFF>)*
      <MULTI_LINE_END>
  >
|
  <#MULTI_LINE_START: 
      ("text:")
      ([" ", "\t"])*
      (<HASH_COMMENT>|<CRLF>)
  >
|
  <#MULTI_LINE_END:
      ("." <CRLF>)
  >              
|
  <#CRLF:
      ("\r\n")
  >
|
  <#NEWLINE:
      ("\n"|"\r"|"\r\n")
  >
|
// multi-line-literal  = [CHAR-NOT-DOT *CHAR_NOT_NEWLINE] NEWLINE 
  < #MULTI_LINE_LITERAL:
      (<CHAR_NOT_DOT> (<CHAR_NOT_NEWLINE>)*)?
      <NEWLINE>
  >  
|
  < #CHAR_NOT_DOT:
      (~[".","\n","\r"])
  >
|
  < #CHAR_NOT_NEWLINE: 
      (~["\n","\r"])
  >   
|
// multi-line-dotstuff = "." 1*CHAR-NOT-CRLF CRLF
// A line containing only "." ends the multi-line.
// Remove a leading '.' if followed by another '.'.
  < #MULTI_LINE_DOTSTUFF:
    "."
    (<CHAR_NOT_NEWLINE>)+
    <NEWLINE>
  >  
}

/******************************************
 * THE SIEVE LANGUAGE GRAMMAR STARTS HERE *
 ******************************************/

// start = commands   
SimpleNode start() :
{  }
{
  { nesting = 0; } // a parser reused through ReInit counts again from the top
  commands()
  (<EOF_HASH_COMMENT>)? // Allow a Hash comment immediately prior to EOF
  <EOF>
  { return jjtThis; }  
}

//   commands = *command
void commands() :
{ }
{
  (command())*
}

//   command = identifier arguments ( ";" / block )
void command() :
{ Token identifier = null; }
{
  (identifier = <IDENTIFIER>) arguments() (";" | block())
  {
    jjtThis.setName(identifier.image);
  }  
}

//   block = "{" commands "}"
void block() :
{ }
{
   "{" { enterNesting(); } commands() "}" { nesting--; }
}

//   arguments = *argument [test / test-list]
void arguments() :
{ }
{
  (argument())* (test() | test_list())?
}

//    argument = string-list / number / tag
void argument() :
{ Token string_list = null, number = null, tag = null; }
{
  (string_list() | number = <NUMBER> | tag = <TAG>)
  {
    Argument value = null; 
    if (null != number)
       value = new NumberArgument(number);
    else if (null != tag)
       value = new TagArgument(tag);
    jjtThis.setValue(value);       
  }
}

//   test = identifier arguments
void test() :
{ Token identifier = null; }
{
  (identifier = <IDENTIFIER> { enterNesting(); } arguments())
  {
    jjtThis.setName(identifier.image);
    nesting--;
  }   
}

//   test-list = "(" test *("," test) ")"
void test_list() :
{ }
{
  "(" test() ("," test())* ")"
}

//   string = quoted-string / multi-line
void string() :
{ Token quoted_string = null, multi_line = null;}
{
  (quoted_string = <QUOTED_STRING> | multi_line = <MULTI_LINE>)
  {
    if (null != quoted_string) {
      jjtThis.setValue(unescape(quoted_string.image.substring(1, quoted_string.image.length() - 1)));
    } else if (null != multi_line) {
      // no backslash escape in a multi-line literal, only dot-stuffing
      jjtThis.setValue(multiLineValue(multi_line.image));
    }
  }
}

//   string-list = "[" string *("," string) "]" / string         ;; if
//   there is only a single string, the brackets are optional
void string_list() :
{ }
{
  ("[" string() ("," string())* "]") | string()
}


   
 
